# Copia este archivo como .streamlit/secrets.toml (o pega su contenido en
# "Secrets" de Streamlit Community Cloud) y reemplaza los valores.
# No subas el archivo real a GitHub.

# "demo" = datos ficticios por sesión (predeterminado).
# "clinical" = autenticación y almacenamiento persistente cifrado.
RENAL_MODE = "demo"

# Solo para RENAL_MODE = "clinical":
# RENAL_DB_PATH = "data/renal.sqlite"
# RENAL_DB_KEY = "pega-aqui-una-clave-fernet"
# RENAL_SETUP_TOKEN = "pega-aqui-un-token-privado"

# Opcional: dirección HTTPS pública para precargar el generador de QR.
# RENAL_PUBLIC_URL = "https://tu-app.streamlit.app"
